{
  "name": "resyst-vault-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Portable, safe context and writeback bridge between AI agents and Obsidian vaults.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "resyst-vault": "./dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests vitest.config.ts",
    "check:no-any": "node scripts/check-no-any.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:no-any && npm test"
  },
  "dependencies": {
    "typebox": "^1.3.12",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
